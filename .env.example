# ============================================================================
# HABIT HEROES - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive credentials
# ============================================================================

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
# The port the Express server will listen on
# Default: 5000 (matches Replit configuration)
PORT=5000

# Node environment (development | production | test)
NODE_ENV=development

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (REQUIRED)
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=require
#
# LOCAL POSTGRESQL EXAMPLE:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/habithero
#
# NEON (PRODUCTION):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# FOR LOCAL DEVELOPMENT, install PostgreSQL:
# - Windows: https://www.postgresql.org/download/windows/
# - macOS: brew install postgresql
# - Linux: sudo apt-get install postgresql
#
# Then create the database:
# createdb habithero
DATABASE_URL=postgresql://postgres:password@localhost:5432/habithero

# ----------------------------------------------------------------------------
# SESSION SECURITY (REQUIRED)
# ----------------------------------------------------------------------------
# Secret key for encrypting session data
# MUST be a strong random string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-character-string-generated-with-crypto

# ----------------------------------------------------------------------------
# REPLIT AUTHENTICATION (OPTIONAL FOR LOCAL DEV)
# ----------------------------------------------------------------------------
# These are Replit-specific OAuth configuration variables
# For local development, you can:
# 1. Leave them commented out to use local authentication only
# 2. OR set them to mock values for testing
#
# REPLIT_DOMAINS: Comma-separated list of deployment domains
# Example: your-app.replit.app,custom-domain.com
# REPLIT_DOMAINS=localhost:5000
#
# ISSUER_URL: OAuth identity provider URL (Replit's OIDC endpoint)
# ISSUER_URL=https://replit.com/oidc
#
# REPL_ID: Unique identifier for your Replit deployment
# REPL_ID=local-development

# ----------------------------------------------------------------------------
# STRIPE PAYMENT INTEGRATION (OPTIONAL FOR LOCAL DEV)
# ----------------------------------------------------------------------------
# Stripe secret key for processing subscriptions
# For development, use TEST mode keys (starts with sk_test_)
# Get your keys from: https://dashboard.stripe.com/test/apikeys
#
# PRODUCTION: sk_live_xxxxxxxxxxxxx
# TEST: sk_test_xxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Stripe public key (used in frontend)
# STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Directory for storing private objects/files
# If not set, defaults to empty string (current directory)
# PRIVATE_OBJECT_DIR=/var/app/storage

# For Google Cloud Storage (production)
# GCS_BUCKET_NAME=your-bucket-name
# GCS_PROJECT_ID=your-project-id
# GCS_CREDENTIALS_PATH=/path/to/service-account.json

# ----------------------------------------------------------------------------
# FEATURE FLAGS (OPTIONAL)
# ----------------------------------------------------------------------------
# Enable/disable specific features for local testing
# ENABLE_SUBSCRIPTIONS=false
# ENABLE_OAUTH=false
# ENABLE_FILE_UPLOAD=true

# ----------------------------------------------------------------------------
# LOGGING & DEBUGGING (OPTIONAL)
# ----------------------------------------------------------------------------
# Log level (error | warn | info | debug)
# LOG_LEVEL=debug

# Enable SQL query logging (drizzle-orm)
# DB_LOGGING=true

# ----------------------------------------------------------------------------
# CORS CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# ----------------------------------------------------------------------------
# TESTING CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Test database URL (separate from development)
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/habithero_test

# Mock external services in test environment
# MOCK_STRIPE=true
# MOCK_OAUTH=true
